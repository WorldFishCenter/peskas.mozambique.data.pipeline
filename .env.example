# Environment Configuration Template
# Copy this file to .env and fill in your actual values
# DO NOT commit .env to version control

# KoBo
KOBO_ASSET_ID_LURIO=your_lurio_asset_id_here
KOBO_ASSET_ID_ADNAP=your_adnap_asset_id_here
KOBO_USERNAME=your_kobo_username_here
KOBO_PASSWORD=your_kobo_password_here
KOBO_TOKEN=your_kobo_api_token_here

# MongoDB
MONGODB_CONNECTION_STRING=mongodb://your_connection_string_here
MONGODB_CONNECTION_STRING_VALIDATION=mongodb://your_validation_connection_string_here

# Google Cloud Platform (full service account JSON on one line)
GCP_SA_KEY=your_gcp_service_account_key_json_content_here

# Pelagic Data Systems
PDS_TOKEN=your_pds_token_here
PDS_SECRET=your_pds_secret_here

# Airtable
AIRTABLE_TOKEN=your_airtable_token_here
AIRTABLE_BASE_ID_FRAME=your_airtable_frame_base_id_here
